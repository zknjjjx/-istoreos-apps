#!/bin/sh /etc/rc.common
# Cloudflare 隧道：每个启用的隧道一个 cloudflared 进程
START=99
STOP=10
USE_PROCD=1
BIN=/usr/bin/cloudflared

start_one() {
	local sec="$1" enabled token
	config_get enabled "$sec" enabled 0
	config_get token "$sec" token
	[ "$enabled" = 1 ] && [ -n "$token" ] || return 0
	procd_open_instance "$sec"
	procd_set_param command "$BIN" tunnel --no-autoupdate --protocol "$PROTO" --edge-ip-version "$IPV" run --token "$token"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	[ -x "$BIN" ] || return 0
	config_load cftunnel
	config_get PROTO main protocol http2
	config_get IPV main ip_version auto
	config_foreach start_one tunnel
}

boot() {
	# 「开机自动连接」关掉时，开机不启动任何隧道
	[ "$(uci -q get cftunnel.main.autostart)" = 0 ] && return 0
	start "$@"
}

service_triggers() {
	procd_add_reload_trigger cftunnel
}
