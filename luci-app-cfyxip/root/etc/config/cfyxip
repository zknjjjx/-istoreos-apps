
config cfyxip 'main'
	option ports '443'
	option sample '4000'
	option threads '200'
	option tcp_tries '3'
	option max_latency '300'
	option validate_path '/cdn-cgi/trace'
	option speed_test '1'
	option speed_host 'speed.cloudflare.com'
	option speed_mb '50'
	option speed_seconds '8'
	option min_speed '1'
	option count '10'
	option recheck '3'
	option keep_old '1'
	option remark '{colo} {speed}MB/s {latency}ms'
	option cron_enable '0'
	option cron_hours '5'
	option cron_minute '0'
	option push '0'
	option gh_token ''
	option gh_repo ''
	option gh_branch 'main'
	option gh_path 'xyip.txt'
	option gh_proxy ''
