#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
chmod +x /usr/bin/cfyxip /usr/libexec/cfyxip /etc/init.d/cfyxip
mkdir -p /etc/cfyxip
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null
/etc/init.d/cfyxip enable 2>/dev/null
/etc/init.d/cfyxip start 2>/dev/null
exit 0
